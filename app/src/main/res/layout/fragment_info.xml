<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/info_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="4dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp">
        <TextView
            android:id="@+id/info_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:text="@string/route_details"
            android:textAppearance="@style/TextAppearance.Boulder.Title"
            android:textColor="@color/on_surface" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/details_intro"
            android:textAppearance="@style/TextAppearance.Boulder.Body"
            android:textColor="@color/on_surface_variant" />
        <com.google.android.material.textfield.TextInputLayout
            style="@style/RouteTextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/problem_name"
            app:counterEnabled="true"
            app:counterMaxLength="30">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etInfoProblemName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext|flagNoExtractUi"
                android:nextFocusForward="@id/etInfoAuthor"
                android:nextFocusDown="@id/etInfoAuthor"
                android:inputType="textCapSentences"
                android:maxLength="30"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            style="@style/RouteTextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/author"
            app:counterEnabled="true"
            app:counterMaxLength="20">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etInfoAuthor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext|flagNoExtractUi"
                android:nextFocusForward="@id/etInfoComment"
                android:nextFocusDown="@id/etInfoComment"
                android:inputType="textCapWords"
                android:maxLength="20"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            style="@style/RouteTextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/comment"
            app:counterEnabled="true"
            app:counterMaxLength="160">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etInfoComment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:imeOptions="flagNoExtractUi"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="160"
                android:maxLines="4"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/grade_pill_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">
            <TextView
                android:id="@+id/grade_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:labelFor="@id/pickerGrade"
                android:text="@string/grade_label"
                android:textAppearance="@style/TextAppearance.Boulder.Title"
                android:textColor="@color/on_surface" />
            <NumberPicker
                android:id="@+id/pickerGrade"
                android:layout_width="wrap_content"
                android:layout_height="128dp"
                android:contentDescription="@string/grade_label"
                android:descendantFocusability="blocksDescendants" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/info_cancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/cancel" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/info_done"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/ok" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
