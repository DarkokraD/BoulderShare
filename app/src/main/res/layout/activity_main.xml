<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_surface"
        app:elevation="0dp">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/app_surface"
            app:title="@string/app_name"
            app:titleTextColor="@color/on_surface"
            app:navigationIconTint="@color/on_surface"
            app:subtitleTextColor="@color/on_surface_variant"
            app:popupTheme="@style/AppTheme.PopupOverlay" />
        <ProgressBar
            android:id="@+id/photo_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:contentDescription="@string/loading_photo"
            android:indeterminate="true"
            android:indeterminateTint="@color/colorPrimary"
            android:visibility="gone" />
    </com.google.android.material.appbar.AppBarLayout>

    <include layout="@layout/content_main" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabGallery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="96dp"
        android:text="@string/choose_photo"
        android:contentDescription="@string/choose_photo"
        android:textColor="@color/on_secondary_container"
        app:backgroundTint="@color/secondary_container"
        app:icon="@drawable/ic_photo"
        app:iconTint="@color/on_secondary_container" />
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabCamera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:text="@string/take_photo"
        android:contentDescription="@string/take_photo"
        android:textColor="@color/on_primary_container"
        app:backgroundTint="@color/primary_container"
        app:icon="@drawable/ic_camera"
        app:iconTint="@color/on_primary_container" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
