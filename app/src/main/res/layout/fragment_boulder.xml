<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/editor_background"
    android:orientation="vertical"
    tools:ignore="Overdraw">
    <!-- The dark canvas also fills the space behind the rounded control panel. -->
    <RelativeLayout
        android:id="@+id/rlBoulderFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/editor_background" />
    <LinearLayout
        android:id="@+id/editor_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/editor_panel_background"
        android:orientation="vertical">
        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Boulder.Button.Tonal"
            android:id="@+id/action_toggle_editor_controls"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:contentDescription="@string/editor_controls_collapse"
            app:icon="@drawable/ic_editor_collapse"
            app:iconGravity="textStart"
            app:iconSize="24dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:iconPadding="0dp"
            android:minWidth="48dp" />
        <LinearLayout
            android:id="@+id/editor_controls_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="14dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="10dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sparkles"
                    app:tint="@color/colorPrimary" />
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/smart_marking"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/smart_marking"
                    android:textAppearance="@style/TextAppearance.Boulder.Body"
                    android:textColor="@color/on_surface" />
            </LinearLayout>
            <TextView
                android:id="@+id/smart_marking_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/on_surface_variant"
                android:visibility="gone" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/action_fit_photo"
                    style="@style/Widget.Boulder.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/fit_photo"
                    app:icon="@drawable/ic_fit"
                    app:iconGravity="textStart"
                    app:iconSize="18dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/action_resize_hold"
                    style="@style/Widget.Boulder.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/resize_hold"
                    app:icon="@drawable/ic_resize"
                    app:iconGravity="textStart"
                    app:iconSize="18dp" />
            </LinearLayout>
            <TextView
                android:id="@+id/editor_gesture_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/editor_gesture_hint"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/on_surface_variant" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawablePadding="6dp"
                    android:id="@+id/legend_start"
                    android:text="@string/start_hold"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="@color/on_surface"
                    app:drawableStartCompat="@drawable/hold_start"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/editor_legend_background"
                    android:padding="4dp"
                    android:clickable="true"
                    android:focusable="true" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawablePadding="6dp"
                    android:id="@+id/legend_regular"
                    android:text="@string/regular_hold"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="@color/on_surface"
                    app:drawableStartCompat="@drawable/hold_regular"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/editor_legend_background"
                    android:padding="4dp"
                    android:clickable="true"
                    android:focusable="true" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawablePadding="6dp"
                    android:id="@+id/legend_top"
                    android:text="@string/top_hold"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="@color/on_surface"
                    app:drawableStartCompat="@drawable/hold_top"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/editor_legend_background"
                    android:padding="4dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <include
        layout="@layout/panel_hold_size" />
</LinearLayout>