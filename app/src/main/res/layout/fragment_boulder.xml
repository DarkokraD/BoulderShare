<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <RelativeLayout
        android:id="@+id/rlBoulderFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/editor_background" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface_container"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/action_fit_photo"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/fit_photo" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/action_resize_hold"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/resize_hold" />
        </LinearLayout>
        <TextView
            android:id="@+id/editor_gesture_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/editor_gesture_hint"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/on_surface_variant" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:drawableStartCompat="@drawable/hold_start"
                android:drawablePadding="6dp"
                android:text="@string/start_hold"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="@color/on_surface" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:drawableStartCompat="@drawable/hold_regular"
                android:drawablePadding="6dp"
                android:text="@string/regular_hold"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="@color/on_surface" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:drawableStartCompat="@drawable/hold_top"
                android:drawablePadding="6dp"
                android:text="@string/top_hold"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="@color/on_surface" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
