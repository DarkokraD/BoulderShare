<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:text="@string/library_eyebrow"
        android:textAppearance="@style/TextAppearance.Boulder.Label"
        android:textColor="@color/on_surface_variant" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="6dp"
        android:text="@string/your_problems"
        android:textAppearance="@style/TextAppearance.Boulder.Display"
        android:textColor="@color/on_surface"
        android:accessibilityHeading="true"
        tools:targetApi="28" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="6dp"
        android:paddingBottom="24dp"
        android:text="@string/library_subtitle"
        android:textAppearance="@style/TextAppearance.Boulder.Body"
        android:textColor="@color/on_surface_variant" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <GridView
            android:id="@+id/gridBoulderProblems"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp"
            android:columnWidth="160dp"
            android:drawSelectorOnTop="false"
            android:gravity="center"
            android:numColumns="auto_fit"
            android:stretchMode="columnWidth"
            android:verticalSpacing="16dp"
            android:horizontalSpacing="12dp" />
        <ScrollView
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingTop="8dp"
                android:paddingBottom="24dp">
                <ImageView
                    android:layout_width="240dp"
                    android:layout_height="180dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/illustration_photo"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:text="@string/empty_title"
                    android:textAppearance="@style/TextAppearance.Boulder.Title"
                    android:textColor="@color/on_surface" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/empty_message"
                    android:textAppearance="@style/TextAppearance.Boulder.Body"
                    android:textColor="@color/on_surface_variant" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>