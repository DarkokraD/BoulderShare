<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <RelativeLayout
        android:id="@+id/rlBoulderFragment"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@color/editor_background" />

    <ScrollView
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:background="@color/surface_container"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_container"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="10dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sparkles"
                    app:tint="@color/colorPrimary" />
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/smart_marking"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/smart_marking"
                    android:textAppearance="@style/TextAppearance.Boulder.Body"
                    android:textColor="@color/on_surface" />
            </LinearLayout>
            <TextView
                android:id="@+id/smart_marking_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/on_surface_variant"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="vertical">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/action_fit_photo"
                    style="@style/Widget.Boulder.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:minHeight="48dp"
                    android:text="@string/fit_photo"
                    app:icon="@drawable/ic_fit"
                    app:iconGravity="textStart"
                    app:iconSize="18dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/action_resize_hold"
                    style="@style/Widget.Boulder.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:minHeight="48dp"
                    android:text="@string/resize_hold"
                    app:icon="@drawable/ic_resize"
                    app:iconGravity="textStart"
                    app:iconSize="18dp" />
            </LinearLayout>
            <TextView
                android:id="@+id/editor_gesture_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/editor_gesture_hint"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/on_surface_variant" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawablePadding="6dp"
                    android:id="@+id/legend_start"
                    android:text="@string/start_hold"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="@color/on_surface"
                    app:drawableStartCompat="@drawable/hold_start" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawablePadding="6dp"
                    android:id="@+id/legend_regular"
                    android:text="@string/regular_hold"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="@color/on_surface"
                    app:drawableStartCompat="@drawable/hold_regular" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawablePadding="6dp"
                    android:id="@+id/legend_top"
                    android:text="@string/top_hold"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="@color/on_surface"
                    app:drawableStartCompat="@drawable/hold_top" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
