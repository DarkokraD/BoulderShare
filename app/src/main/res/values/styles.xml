<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorOnSecondary">@color/on_primary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerLow">@color/app_surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container</item>
        <item name="colorSurfaceContainerHighest">@color/surface_high</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorSurfaceVariant">@color/surface_container</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/light_system_bars</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="fontFamily">sans</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Boulder.Display</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Boulder.Headline</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Boulder.Title</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Boulder.Dialog</item>
        <item name="materialButtonStyle">@style/Widget.Boulder.Button.Primary</item>
    </style>
    <style name="AppTheme.NoActionBar" parent="AppTheme" />
    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.Material3" />
    <style name="TextAppearance.Boulder.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/outfit_bold</item>
        <item name="android:fontFamily">@font/outfit_bold</item>
        <item name="android:textSize">34sp</item>
        <item name="android:letterSpacing">-0.025</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>
    <style name="TextAppearance.Boulder.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/outfit_bold</item>
        <item name="android:fontFamily">@font/outfit_bold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>
    <style name="TextAppearance.Boulder.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/outfit_semibold</item>
        <item name="android:fontFamily">@font/outfit_semibold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>
    <style name="TextAppearance.Boulder.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>
    <style name="TextAppearance.Boulder.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>
    <style name="Widget.Boulder.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/brand_button_background</item>
        <item name="android:textColor">@color/brand_button_foreground</item>
        <item name="iconTint">@color/brand_button_foreground</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="fontFamily">@font/outfit_semibold</item>
        <item name="android:fontFamily">@font/outfit_semibold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.Boulder.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="fontFamily">@font/outfit_semibold</item>
        <item name="android:fontFamily">@font/outfit_semibold</item>
        <item name="android:textSize">15sp</item>
        <item name="strokeColor">@color/outline_variant</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.Boulder.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="fontFamily">@font/outfit_semibold</item>
        <item name="android:fontFamily">@font/outfit_semibold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.Boulder.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardBackgroundColor">@color/surface_high</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/outline_variant</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="ThemeOverlay.Boulder.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Boulder.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.Boulder.Title.Text</item>
        <item name="colorSurface">@color/app_surface</item>
    </style>
    <style name="MaterialAlertDialog.Boulder.Title.Text" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textAppearance">@style/TextAppearance.Boulder.Title</item>
    </style>
    <style name="ShapeAppearance.Boulder.Dialog" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">28dp</item>
    </style>
    <style name="RouteTextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface_high</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
    </style>
</resources>
